{
  "name": "pglambda",
  "version": "0.0.1",
  "description": "Typesafe Modern Postgres SQL Builder",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "pnpm -r check",
    "lint": "oxlint packages --ignore-pattern '*.d.ts'",
    "lint:fix": "oxlint packages --fix --ignore-pattern '*.d.ts'",
    "format": "oxfmt packages",
    "format:check": "oxfmt packages --check",
    "test": "pnpm -r run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "husky": "^9.1.7",
    "oxfmt": "^0.31.0",
    "oxlint": "^1.46.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.29.3"
}