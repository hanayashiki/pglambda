exports[`operator return types > date/time arithmetic result types 1`] = `
{
  "date + integer": "date",
  "date - date": "integer",
  "date - integer": "date",
  "interval * int": "interval",
  "interval + interval": "interval",
  "interval / int": "interval",
  "time + interval": "time with time zone",
  "time - time": "ERROR: operator does not exist: time with time zone - time with time zone",
  "timestamp + interval": "timestamp with time zone",
  "timestamp - interval": "timestamp with time zone",
  "timestamp - timestamp": "interval",
}
`;

