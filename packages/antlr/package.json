{
  "name": "@pglambda/antlr",
  "type": "module",
  "version": "2.2.8",
  "description": "the generated antlr syntax",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./antlr4": {
      "types": "./src/antlr4.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc",
    "build": "pnpm gen && tsup",
    "gen": "antlr4 -Dlanguage=TypeScript src/PGLLexer.g4 && antlr4 -Dlanguage=TypeScript -visitor src/PGLParser.g4",
    "lint": "eslint"
  },
  "license": "MIT",
  "public": true,
  "devDependencies": {
    "antlr4": "^4.13.2",
    "pgsql-parser": "^17.9.11",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18",
    "tsup": "^8.0.0"
  }
}
